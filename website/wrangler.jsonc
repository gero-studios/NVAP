{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nvap-landing",
  "main": "worker.js",
  "account_id": "1b277849b0ec74d8f21c6bfa5cd86251",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "neurolytics.net/*",
      "zone_name": "neurolytics.net"
    },
    {
      "pattern": "www.neurolytics.net/*",
      "zone_name": "neurolytics.net"
    },
    {
      "pattern": "nueroanalytics.com/*",
      "zone_name": "nueroanalytics.com"
    },
    {
      "pattern": "www.nueroanalytics.com/*",
      "zone_name": "nueroanalytics.com"
    }
  ]
}
